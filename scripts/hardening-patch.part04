  `  // Existing portfolio cap remains additive; projected 2.5% risk is authoritative.
  if (autoAi) {
    const currentOpenRiskPercent = computeOpenRiskPercent(openTradesForRisk, balanceUSD) ?? 0;
    const newTradeRiskPercent = +((sizing.actualRiskUSD / balanceUSD) * 100).toFixed(4);
    const totalCheck = checkTotalOpenRisk(currentOpenRiskPercent, newTradeRiskPercent);
