eservations.delete(token);
  }
}

function reservedRiskForAccount(accountId, dayKey, nowMs = Date.now()) {
  cleanupProjectedRiskReservations(nowMs);
  let total = 0;
  for (const reservation of projectedRiskReservations.values()) {
    if (reservation.accountId === accountKey(accountId) && reservation.dayKey === dayKey) {
      total += Number(reservation.riskUSD) || 0;
    }
  }
  return +total.toFixed(2);
}

export function previewProjectedRiskBudget({
  accountId,
  balanceUSD,
  openRiskUSD = 0,
  requestedRiskUSD = 0,
  now = new Date(),
} = {}, cfg = riskConfig()) {
  const lock = checkDailyRiskLock({ accountId, balanceUSD, now }, cfg);
  const dayKey = nyDateKey(now);
  const realizedLossUSD = Math.max(0, -(Number(lock.realizedPnL) || 0));
  const openRisk = Math.max(0, Number(openRiskUSD) || 0);
  const requested = Math.max(0, Number(requestedRiskUSD) || 0);
  const reservedRiskUSD = reservedRiskForAccount(accountId, dayKey, now.getTime());
  const remainingBeforeCandidateUSD = +Math.max(
    0,
    lock.lossLimit - realizedLossUSD - openRisk - reservedRiskUSD
  ).toFixed(2);
  const approvedRiskUSD = +Math.min(requested, remainingBeforeCandidateUSD).toFixed(2);
  const projectedLossUSD = +(realizedLossUSD + openRisk + reservedRiskUSD + approvedRiskUSD).toFixed(2);
  const allowed = !lock.tradingLocked && approvedRiskUSD > 0;

  return {
    allowed,
    capped: requested > approvedRiskUSD + 0.005,
    tradingLocked: lock.tradingLocked,
    startingBalance: lock.startingBalance,
    dailyMaxLossPercent: cfg.dailyMaxDrawdownPercent,
    dailyLossLimitUSD: lock.lossLimit,
    realizedLossUSD,
    openRiskUSD: +openRisk.toFixed(2),
    reservedRiskUSD,
    requestedRiskUSD: +requested.toFixed(2),
    approvedRiskUSD,
    remainingBeforeCandidateUSD,
    projectedLossUSD,
    projectedLossPercent: lock.startingBalance > 0
      ? +((projectedLossUSD / lock.startingBalance) * 100).toFixed(4)
      : null,
    reason: allowed
      ? null
      : lock.reason || 'No projected daily risk budget remains.',
  };
}

export function reserveProjectedRiskBudget({
  accountId,
  balanceUSD,
  openRiskUSD = 0,
  requestedRiskUSD = 0,
  now = new Date(),
  ttlMs = 120000,
  requireFullAmount = true,
} = {}, cfg = riskConfig()) {
  const preview = previewProjectedRiskBudget({
    accountId,
    balanceUSD,
    openRiskUSD,
    requestedRiskUSD,
    now,
  }, cfg);

  if (
    !preview.allowed ||
    (requireFullAmount && preview.approvedRiskUSD + 0.005 < preview.requestedRiskUSD)
  ) {
    return {
      ...preview,
      allowed: false,
      reason: preview.reason ||
        'Projected daily risk only permits $' + preview.approvedRiskUSD.toFixed(2) +
        ' of $' + preview.requestedRiskUSD.toFixed(2) + ' requested.',
    };
  }

  const token = \`\${accountKey(accountId)}:\${Date.now()}:\${Math.random().toString(36).slice(2)}\`;
  projectedRiskReservations.set(token, {
    accountId: accountKey(accountId),
    dayKey: nyDateKey(now),
    riskUSD: preview.approvedRiskUSD,
    expiresAt: Date.now() + ttlMs,
  });
  return { ...preview, allowed: true, token };
}

export function releaseProjectedRiskReservation(token) {
  if (token) projectedRiskReservations.delete(token);
}

export function commitProjectedRiskReservation(token, ttlMs = 120000) {
  const reservation = token ? projectedRiskReservations.get(token) : null;
  if (!reservation) return false;
  reservation.expiresAt = Date.now() + ttlMs;
  return true;
}

