# Signal Stack authenticates to this bridge with these two values.
# Generate unique values on the Windows VPS; use the exact same values in
# app.ssforexclub.com/dashboard/ftmo.
BRIDGE_API_KEY=replace-with-at-least-32-random-characters
BRIDGE_SECRET=replace-with-at-least-32-random-characters
BRIDGE_INSTANCE_ID=ftmo-primary
BRIDGE_ALLOWED_CLOCK_SKEW_SEC=60
BRIDGE_BIND_HOST=127.0.0.1
BRIDGE_PORT=8787

# Exact FTMO MetaTrader 5 credentials from Account MetriX > Credentials.
# Use the MASTER trading password, not the investor/read-only password.
MT5_LOGIN=12345678
MT5_PASSWORD=replace-with-the-master-trading-password
MT5_SERVER=copy-the-exact-ftmo-server-name

# Optional when MetaTrader 5 is installed in the default location.
# Keep doubled backslashes in this .env example.
MT5_TERMINAL_PATH=C:\\Program Files\\FTMO MetaTrader 5\\terminal64.exe
MT5_DEFAULT_DEVIATION=20
MT5_MAGIC_NUMBER=56001

# Broker symbol normalization and defense-in-depth execution gates.
# FTMO index defaults in Signal Stack are US30.cash, US100.cash, US500.cash.
# Map any terminal-specific names here, for example:
# MT5_SYMBOL_MAP_JSON={"US30.cash":"US30","US100.cash":"USTEC","US500.cash":"US500"}
MT5_SYMBOL_SUFFIX=
MT5_SYMBOL_MAP_JSON={}
MT5_REQUIRE_PROTECTIVE_ORDERS=true
MT5_MIN_RR=1.5
