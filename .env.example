# ── Supabase ──────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_API_URL=http://localhost:3001

# ── Anthropic Claude API ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Alpaca credentials (server-side only) ─────────────────────────────────────
ALPACA_LIVE_API_KEY=your_alpaca_key
ALPACA_LIVE_API_SECRET=your_alpaca_secret
ALPACA_API_KEY=your_alpaca_key
ALPACA_API_SECRET=your_alpaca_secret
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_TRADING_BASE_URL=https://api.alpaca.markets

# ── OANDA ─────────────────────────────────────────────────────────────────────
OANDA_API_KEY=your_oanda_api_key
OANDA_ACCOUNT_ID=your_oanda_account_id
OANDA_ENV=practice                          # practice | live
OANDA_API_BASE_PRACTICE=https://api-fxpractice.oanda.com
OANDA_API_BASE_LIVE=https://api-fxtrade.oanda.com

# ── Forex / Metals Signal Engine ──────────────────────────────────────────────

# Live execution toggle — KEEP FALSE until fully tested
FOREX_AUTO_TRADE_ENABLED=false

# Signal qualification thresholds (MVP: low bar, small repeatable wins)
FOREX_MIN_SCORE=8               # out of 20
FOREX_MIN_CONFIDENCE=20         # %

# Spread limits — separate for forex and metals
FOREX_MAX_SPREAD_PIPS=5.0
METALS_MAX_SPREAD_PIPS=50       # Gold/Silver have naturally wider spreads

# Fixed position sizing (MVP: 0.01 lots = micro lot)
FOREX_FIXED_LOT_SIZE=0.01       # 0.01 lots = 1,000 units forex / 1 oz metals

# Fixed stop-loss pips (per instrument class)
FOREX_FIXED_STOP_LOSS_PIPS=20   # Regular forex pairs
# JPY pairs: hardcoded 25 pips
GOLD_STOP_LOSS_PIPS=100         # XAU_USD (100 × $0.01 = $1.00 SL per oz)
SILVER_STOP_LOSS_PIPS=50        # XAG_USD

# Take-profit risk/reward ratio
FOREX_TAKE_PROFIT_RR=1.5        # TP = SL distance × 1.5

# Risk display (not used for dynamic sizing — shown on signal cards)
FOREX_RISK_PER_TRADE_PERCENT=3

# Watchlist — comma-separated OANDA instrument codes
# XAU_USD = Gold, XAG_USD = Silver
FOREX_WATCHLIST=EUR_USD,GBP_USD,USD_JPY,AUD_USD,USD_CAD,XAU_USD,XAG_USD

# ── Optional tuning ───────────────────────────────────────────────────────────
FOREX_MAX_DAILY_TRADES=3
FOREX_MAX_DAILY_LOSS_PERCENT=2
FOREX_ATR_SPIKE_MULTIPLIER=2.5
FOREX_MAX_CANDLE_BODY_RATIO=0.85
FOREX_MAX_EMA_DEVIATION_ATR=3.0
FOREX_SPREAD_SPIKE_MULTIPLIER=2.0
