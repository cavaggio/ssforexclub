# ── Supabase ──────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_API_URL=http://localhost:3001

# ── Anthropic Claude API ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Alpaca credentials (server-side only) ─────────────────────────────────────
ALPACA_LIVE_API_KEY=your_alpaca_key
ALPACA_LIVE_API_SECRET=your_alpaca_secret
ALPACA_API_KEY=your_alpaca_key
ALPACA_API_SECRET=your_alpaca_secret
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_TRADING_BASE_URL=https://api.alpaca.markets

# ── OANDA ─────────────────────────────────────────────────────────────────────
OANDA_API_KEY=your_oanda_api_key
OANDA_ACCOUNT_ID=your_oanda_account_id
OANDA_ENV=practice                          # practice | live
OANDA_API_BASE_PRACTICE=https://api-fxpractice.oanda.com
OANDA_API_BASE_LIVE=https://api-fxtrade.oanda.com

# ── Futures: NinjaTrader / Tradovate ──────────────────────────────────────────
# Master switch — enables the connector, credential saving, validation and
# diagnostics (sim/read-only). Safe to leave ON; it does NOT permit live orders.
# Live order execution is separately gated by NINJATRADER_LIVE_EXECUTION_ENABLED
# (keep FALSE until intentionally enabled).
NINJATRADER_FUTURES_ENABLED=true
NINJATRADER_LIVE_EXECUTION_ENABLED=false
# NinjaTrader retail order routing uses the Tradovate REST API. Paper/sim and
# live are SEPARATE hosts — never mixed. Defaults are the public Tradovate URLs.
TRADOVATE_DEMO_URL=https://demo.tradovateapi.com/v1
TRADOVATE_LIVE_URL=https://live.tradovateapi.com/v1

# ── Futures: Topstep (TopstepX / ProjectX) ────────────────────────────────────
# TOPSTEP_ENABLED       — master switch (connect + monitor; read-only).
# TOPSTEP_CLOUD_EXECUTION_ALLOWED — COMPLIANCE GATE. Topstep currently prohibits
#   cloud/VPS/server-side automation, so this MUST stay false; no order leaves the
#   server while it is false. Only set true if Topstep's rules change to permit it.
# TOPSTEP_LIVE_EXECUTION_ENABLED — additionally required for funded/live accounts.
TOPSTEP_ENABLED=false
TOPSTEP_CLOUD_EXECUTION_ALLOWED=false
TOPSTEP_LIVE_EXECUTION_ENABLED=false
TOPSTEP_API_BASE_URL=https://api.topstepx.com

# ── Forex / Metals Signal Engine ──────────────────────────────────────────────

# Live execution toggle — KEEP FALSE until fully tested
FOREX_AUTO_TRADE_ENABLED=false

# Signal qualification thresholds (MVP: low bar, small repeatable wins)
FOREX_MIN_SCORE=8               # out of 20
FOREX_MIN_CONFIDENCE=85

# Spread limits — separate for forex and metals
FOREX_MAX_SPREAD_PIPS=5.0
METALS_MAX_SPREAD_PIPS=50       # Gold/Silver have naturally wider spreads

# Fixed position sizing (MVP: 0.01 lots = micro lot)
FOREX_FIXED_LOT_SIZE=0.01       # 0.01 lots = 1,000 units forex / 1 oz metals

# Fixed stop-loss pips (per instrument class)
FOREX_FIXED_STOP_LOSS_PIPS=20   # Regular forex pairs
# JPY pairs: hardcoded 25 pips
GOLD_STOP_LOSS_PIPS=100         # XAU_USD (100 × $0.01 = $1.00 SL per oz)
SILVER_STOP_LOSS_PIPS=50        # XAG_USD

# Take-profit risk/reward ratio
FOREX_TAKE_PROFIT_RR=1.5        # TP = SL distance × 1.5

# Risk display (not used for dynamic sizing — shown on signal cards)
FOREX_RISK_PER_TRADE_PERCENT=3

# Central risk management — enforced by server/riskManager.js across EVERY
# execution engine (V3, V3.5, ICT, Auto AI). Per-trade risk is a hard cap that
# no confidence/quality score can override; the daily drawdown locks new entries
# (open trades keep being managed) and resets at NY midnight; auto execution
# requires confidence >= the floor.
RISK_MAX_PER_TRADE_PERCENT=1.4
RISK_DAILY_MAX_DRAWDOWN_PERCENT=2.8
RISK_AUTO_EXECUTION_MIN_CONFIDENCE=85
# Auto AI portfolio cap — total concurrent open risk across all positions.
AUTO_AI_MAX_TOTAL_OPEN_RISK_PERCENT=4.5

# Watchlist — comma-separated OANDA instrument codes
# Priority pairs only: GBP_USD, EUR_USD, AUD_CAD, GBP_JPY, USD_CAD, EUR_AUD
FOREX_WATCHLIST=GBP_USD,EUR_USD,AUD_CAD,GBP_JPY,USD_CAD,EUR_AUD

# ── Optional tuning ───────────────────────────────────────────────────────────
# Auto AI daily trade cap (trade COUNT only — all risk/loss/margin/duplicate/
# live-ack guards stay enforced). Preferred var; falls back to the legacy
# FOREX_MAX_DAILY_TRADES, then a safe default of 10.
AUTO_AI_DAILY_TRADE_CAP=10
FOREX_MAX_DAILY_TRADES=10
FOREX_MAX_DAILY_LOSS_PERCENT=2
FOREX_ATR_SPIKE_MULTIPLIER=2.5
FOREX_MAX_CANDLE_BODY_RATIO=0.85
FOREX_MAX_EMA_DEVIATION_ATR=3.0
FOREX_SPREAD_SPIKE_MULTIPLIER=2.0

# V3 quality-confirmation safety switches
FOREX_ACTIVE_WINDOW_V3_BRIDGE=false
FOREX_PERFECT_ALIGNMENT_BYPASS_ENABLED=false

# V3 quality-confirmation thresholds
V3_QUALITY_SETUP_MIN_SCORE=62
V3_QUALITY_SETUP_MIN_CONFIDENCE=80
V3_QUALITY_TRIGGER_MIN_SUPPORTS=1
V3_QUALITY_MAX_SIGNAL_AGE_SEC=600
V3_QUALITY_MAX_PRICE_DRIFT_ATR=0.15
V3_QUALITY_MAX_ENTRY_DISTANCE=0.55
FOREX_MIN_EXECUTABLE_RR=1.5
