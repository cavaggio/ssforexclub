# =============================================================================
# Signal Stack — web/.env.example
#
# Platform-level secrets ONLY. Per-user broker credentials (OANDA / Alpaca
# tokens) are NEVER stored here — they live encrypted in the broker_connections
# table, scoped to each Clerk user.
#
# Copy to .env.local for local dev. Vercel: set these in Project → Settings →
# Environment Variables.
# =============================================================================

# ── Clerk authentication ─────────────────────────────────────────────────────
# https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# ── Supabase Postgres (NOT Supabase Auth) ────────────────────────────────────
# We use Supabase only as managed Postgres. Auth is Clerk.
# Service-role key MUST be server-only. Never expose to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi…replace_me

# ── Encryption key for broker credentials (AES-256-GCM) ──────────────────────
# 32-byte key, hex-encoded (64 hex chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DO NOT rotate without re-encrypting every row in broker_connections.
ENCRYPTION_KEY=replace_me_with_64_hex_chars

# ── Broker environment URLs (no secrets — just URLs) ─────────────────────────
OANDA_PRACTICE_URL=https://api-fxpractice.oanda.com
OANDA_LIVE_URL=https://api-fxtrade.oanda.com
ALPACA_PAPER_URL=https://paper-api.alpaca.markets
ALPACA_LIVE_URL=https://api.alpaca.markets

# ── Platform-level live-trading kill switch (2026-05-27 user-toggle upgrade) ─
# Per-user trading mode (Paper / Live) is the PRIMARY control. This flag is
# an emergency platform-wide kill switch that overrides every user's live
# selection — set to "false" to force all users into practice/paper.
#
# When unset, the resolver falls back to FOREX_ALLOW_LIVE_EXECUTION (legacy
# name, kept for back-compat with the old scanner-side flag).
PLATFORM_LIVE_TRADING_ENABLED=false

# ── Express scanner location (private network or localhost in dev) ───────────
# The Next.js app proxies authenticated requests here. Per-user broker credentials
# are decrypted server-side and forwarded ONLY for the resolved user.
SCANNER_BASE_URL=http://localhost:3001
